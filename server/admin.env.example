# --- Admin Server config (SECRETS - never commit) ---
# 这是模板文件。真实配置请复制为 admin.env 后填写，admin.env 已被 .gitignore 排除。
#
#   cp admin.env.example admin.env
#
ADMIN_APP_NAME=quantum-admin
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000

# 生成强密钥（64 位随机 base64url）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=CHANGE-ME-generate-a-long-random-string
# 令牌有效期（秒），默认 12 小时
ADMIN_TOKEN_TTL=43200

# 种子管理员账号（首次启动自动创建）
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=CHANGE-ME

# ---- 数据库 ----
# 留空则回落到本地 JSON 文件（data/db.json），服务仍可启动。
# ⚠ 密码若含 @ / : / / 等字符，必须做 URL 编码，否则连接串解析会错乱。
#   python -c "from urllib.parse import quote; print(quote('你的密码'))"
DATABASE_URL=

# 留空则不启用 Redis。
# ⚠ redis 客户端锁定 5.0.8：8.x 会发送 RESP3 HELLO，Redis 5.x 不支持。
REDIS_URL=

# ---- 风控硬约束 ----
MAX_MARGIN_RISK=0.01
MIN_LOT=0.01

# ---- 积分与推广 ----
# 注册赠送积分
POINTS_SIGNUP_BONUS=100
# 积分有效期（天）
POINTS_VALID_DAYS=30
# 上级分成比例
POINTS_COMMISSION_RATE=0.10

# ---- 授权码（Phase 7）----
# true = 所有受控接口必须携带 X-License-Key 头，否则 402
LICENSE_REQUIRED=false

# ---- 跨域 ----
# 生产建议改成具体域名，不要用 *
ADMIN_CORS_ORIGINS=*